# ============================================================
# RECOMMENDATION FUNCTION
# ============================================================

def recommend(genre, max_duration, min_rating):

    results = df[
        (df["Genre"] == genre) &
        (df["Duration"] <= max_duration) &
        (df["Rating"] >= min_rating)
    ].sort_values("Rating", ascending=False)

    if results.empty:
        return """
        <div class="empty">
            <h2>No movies found</h2>
            <p>Try changing your filters.</p>
        </div>
        """

    html = ""

    for _, movie in results.head(6).iterrows():

        poster = posters.get(
            movie["Title"],
            "https://via.placeholder.com/300x450?text=No+Poster"
        )

        html += f"""
        <div class="movie-card">

            <img
                src="{poster}"
                class="poster"
            >

            <div class="movie-info">

                <h2>{movie["Title"]}</h2>

                <div class="tags">
                    <span>★ {movie["Rating"]}</span>
                    <span>{movie["Genre"]}</span>
                    <span>{movie["Duration"]} min</span>
                </div>

                <p class="description">
                    {movie["Description"]}
                </p>

                <p class="cast">
                    <b>Main Cast</b><br>
                    {movie["Cast"]}
                </p>

            </div>

        </div>
        """

    return html



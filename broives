# CREATE APP
# ============================================================

with gr.Blocks(
    title="Brovies",
    fill_width=True,
    fill_height=True,
    css=css
) as app:

    with gr.Column(elem_id="app"):

        # HEADER

        gr.HTML("""
        <div id="header">
            <h1>BROVIES</h1>
            <p>Find your next movie</p>
        </div>
        """)


        # FILTERS

        with gr.Column(elem_classes="filter-area"):

            with gr.Row():

                with gr.Column(scale=1):

                    genre = gr.Dropdown(
                        choices=sorted(
                            df["Genre"].unique().tolist()
                        ),
                        value="Science Fiction",
                        label="Genre"
                    )

                with gr.Column(scale=1):

                    max_duration = gr.Slider(
                        minimum=60,
                        maximum=210,
                        value=180,
                        step=5,
                        label="Maximum Duration"
                    )

                with gr.Column(scale=1):

                    min_rating = gr.Slider(
                        minimum=5,
                        maximum=9,
                        value=7,
                        step=0.1,
                        label="Minimum Rating"
                    )


            button = gr.Button(
                "FIND MOVIES",
                variant="primary",
                elem_classes="find-button"
            )


        # RESULTS TITLE

        gr.HTML("""
        <div id="results-title">
            Recommended Movies
        </div>
        """)


        # RESULTS

        output = gr.HTML()


        # BUTTON ACTION

        button.click(
            fn=recommend,
            inputs=[
                genre,
                max_duration,
                min_rating
            ],
            outputs=output
        )


        # INITIAL MOVIES

        app.load(
            fn=recommend,
            inputs=[
                genre,
                max_duration,
                min_rating
            ],
            outputs=output
        )


# ============================================================
# LAUNCH
# ============================================================

app.launch(
    share=True,
    inbrowser=True
)
